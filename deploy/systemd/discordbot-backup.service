[Unit]
Description=Verified encrypted DiscordBot backup

[Service]
Type=oneshot
User=discordbot-deploy
Group=discordbot
WorkingDirectory=/var/lib/discordbot
ExecStart=/opt/discordbot/current/.venv/bin/python -I /opt/discordbot/current/app/deploy/launch.py operations backup --config /etc/discordbot/config.json --credentials %d
LoadCredential=db_key:/etc/discordbot/secrets/db_key
Environment=PYTHON_DOTENV_DISABLED=1 PYTHONDONTWRITEBYTECODE=1
UMask=0077
TimeoutStartSec=180
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/discordbot
StandardOutput=journal
StandardError=journal
