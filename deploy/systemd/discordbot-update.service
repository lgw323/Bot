[Unit]
Description=Validated immutable DiscordBot update
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=discordbot-deploy
Group=discordbot
WorkingDirectory=/var/lib/discordbot
ExecStart=/opt/discordbot/current/.venv/bin/python -I /opt/discordbot/current/app/deploy/launch.py operations deploy --config /etc/discordbot/config.json --credentials %d --policy /etc/discordbot/update.json --wheels /var/lib/discordbot/wheels
LoadCredential=db_key:/etc/discordbot/secrets/db_key
Environment=PYTHON_DOTENV_DISABLED=1 PYTHONDONTWRITEBYTECODE=1
UMask=0077
TimeoutStartSec=1800
TimeoutStopSec=300
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/discordbot /var/lib/discordbot
StandardOutput=journal
StandardError=journal
